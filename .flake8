[flake8]
max-line-length = 120
exclude = venv,__pycache__,src/migrations/versions
# Pre-existing whitespace/formatting inconsistencies across the whole
# codebase, unrelated to this pass — ignored here rather than reformatting
# every file in a security-fix branch. A dedicated formatting pass (e.g.
# running black/autopep8 once) should fix these for real and then this
# ignore list should shrink back to just genuine style preferences.
extend-ignore = W291,W293,W391,W292,E122,E128,E266,E302,E303,E301,E201,E202,E501
